  <!-- SERVICIOS -->
  <section id="servicios" class="servicios">
    <div class="container">
      <h2 class="section-title">Nuestros Servicios</h2>
      <p class="section-subtitle">Soluciones de limpieza adaptadas a tus necesidades</p>
      <div class="slider-wrapper">
        <button class="slider-btn slider-prev" aria-label="Anterior">&#10094;</button>
        <div class="slider-container">
          <div class="slider-track">
            <div class="servicio-card">
              <div class="servicio-icon">🏠</div>
              <h3>Limpieza de Hogares</h3>
              <p>Mantenemos tu hogar impecable con atención al detalle en cada rincón, desde cocina y baños hasta recámaras y áreas comunes.</p>
            </div>
            <div class="servicio-card">
              <div class="servicio-icon">🏢</div>
              <h3>Limpieza de Oficinas</h3>
              <p>Espacios de trabajo limpios y desinfectados para un ambiente profesional y productivo todos los días.</p>
            </div>
            <div class="servicio-card">
              <div class="servicio-icon">🏬</div>
              <h3>Limpieza de Departamentos</h3>
              <p>Servicio adaptado a departamentos de cualquier tamaño, cuidando cada espacio para que lo disfrutes al máximo.</p>
            </div>
            <div class="servicio-card">
              <div class="servicio-icon">🏪</div>
              <h3>Limpieza de Locales</h3>
              <p>Locales comerciales relucientes que proyectan la mejor imagen a tus clientes y visitantes.</p>
            </div>
            <div class="servicio-card">
              <div class="servicio-icon">✨</div>
              <h3>Limpiezas Profundas</h3>
              <p>Servicio intensivo que cubre cada detalle: pisos, paredes, vidrios, muebles y áreas difíciles de alcanzar.</p>
            </div>
            <div class="servicio-card">
              <div class="servicio-icon">📦</div>
              <h3>Limpieza Post Mudanza</h3>
              <p>Dejamos tu nuevo espacio listo para estrenar o tu antiguo hogar impecable para la entrega.</p>
            </div>
          </div>
        </div>
        <button class="slider-btn slider-next" aria-label="Siguiente">&#10095;</button>
      </div>
      <div class="slider-dots"></div>
    </div>
  </section>

  <!-- NOSOTROS -->
  <section id="nosotros" class="nosotros">
    <div class="container nosotros-content">
      <div class="nosotros-texto">
        <h2 class="section-title">¿Por qué elegirnos?</h2>
        <p>En <strong>Limpio Aroma</strong> nos dedicamos a brindar un servicio de limpieza excepcional con atención al detalle y compromiso con la satisfacción del cliente.</p>
        <ul class="ventajas-lista">
          <li>
            <span class="check">✓</span>
            <span>Personal capacitado y de confianza</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Productos de alta calidad y ecológicos</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Horarios flexibles que se adaptan a ti</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Presupuestos sin compromiso</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Garantía de satisfacción en cada servicio</span>
          </li>
        </ul>
      </div>
      <div class="nosotros-stats">
        <div class="stat">
          <span class="stat-number">500+</span>
          <span class="stat-label">Clientes Satisfechos</span>
        </div>
        <div class="stat">
          <span class="stat-number">8+</span>
          <span class="stat-label">Años de Experiencia</span>
        </div>
        <div class="stat">
          <span class="stat-number">100%</span>
          <span class="stat-label">Compromiso</span>
        </div>
      </div>
    </div>
  </section>



  <!-- CONTACTO -->
  <section id="contacto" class="contacto">
    <div class="container">
      <h2 class="section-title">Contáctanos</h2>
      <p class="section-subtitle">Solicita tu cotización gratuita hoy mismo. Nos pondremos en contacto contigo lo antes posible.</p>
      <div class="contacto-grid">
        <form class="contacto-form" id="contacto-form">
          <div class="form-group">
            <input type="text" id="nombre" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <input type="tel" id="telefono" placeholder="Tu teléfono" />
          </div>
          <div class="form-group">
            <select id="servicio">
              <option value="">Selecciona un servicio</option>
              <option value="Limpieza de Hogares">Limpieza de Hogares</option>
              <option value="Limpieza de Oficinas">Limpieza de Oficinas</option>
              <option value="Limpieza de Departamentos">Limpieza de Departamentos</option>
              <option value="Limpieza de Locales">Limpieza de Locales</option>
              <option value="Limpieza Profunda">Limpieza Profunda</option>
              <option value="Limpieza Post Mudanza">Limpieza Post Mudanza</option>
            </select>
          </div>
          <div class="form-group">
            <textarea id="mensaje" placeholder="Cuéntanos sobre tu espacio y necesidades" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-full">📲 Enviar por WhatsApp</button>
        </form>
        <script is:inline>
          document.getElementById('contacto-form').addEventListener('submit', function(e) {
            e.preventDefault();
            var nombre = document.getElementById('nombre').value;
            var telefono = document.getElementById('telefono').value;
            var servicio = document.getElementById('servicio').value;
            var mensaje = document.getElementById('mensaje').value;

            var partes = [];
            partes.push('*NUEVA SOLICITUD - LIMPIO AROMA*');
            partes.push('');
            partes.push('Nombre: ' + nombre);
            if (telefono) partes.push('Telefono: ' + telefono);
            if (servicio) partes.push('Servicio: ' + servicio);
            if (mensaje) partes.push('Mensaje: ' + mensaje);
            partes.push('');
            partes.push('Enviado desde la web de Limpio Aroma');

            var texto = partes.join(String.fromCharCode(10));
            var url = 'https://wa.me/593990340068?text=' + encodeURIComponent(texto);
            window.open(url, '_blank');
          });
        </script>
        <div class="contacto-info">
          <div class="info-item">
            <span class="info-icon">📍</span>
            <div>
              <strong>Ubicación</strong>
              <p>Quito, Ecuador</p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon">📞</span>
            <div>
              <strong>Teléfono</strong>
              <p><a href="tel:0990340068">0990340068</a></p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon">✉️</span>
            <div>
              <strong>Email</strong>
              <p><a href="mailto:llimpioaroma@gmail.com">llimpioaroma@gmail.com</a></p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon">🕐</span>
            <div>
              <strong>Horario</strong>
              <p>Lunes a Domingo: 7:00 AM - 7:00 PM</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-content">
      <div class="footer-brand">
        <img src="/imagenes/Logo.jpeg" alt="Limpio Aroma" class="footer-logo" />
        <p>Servicio profesional de limpieza con los más altos estándares de calidad.</p>
      </div>
      <div class="footer-links">
        <h4>Enlaces</h4>
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#nosotros">Nosotros</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>
      <div class="footer-social">
        <h4>Síguenos</h4>
        <div class="social-icons">
          <a href="https://www.facebook.com/share/1BfqN28HCQ/" target="_blank" aria-label="Facebook">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://wa.me/593990340068" target="_blank" aria-label="WhatsApp">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Limpio Aroma. Todos los derechos reservados.</p>
    </div>
  </footer>

  <script is:inline>
    (function() {
      var track = document.querySelector('.slider-track');
      var cards = document.querySelectorAll('.slider-track .servicio-card');
      var prevBtn = document.querySelector('.slider-prev');
      var nextBtn = document.querySelector('.slider-next');
      var dotsContainer = document.querySelector('.slider-dots');
      var current = 0;
      var total = cards.length;
      var interval;

      // Create dots
      for (var i = 0; i < total; i++) {
        var dot = document.createElement('span');
        dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('data-index', i);
        dotsContainer.appendChild(dot);
      }

      var dots = document.querySelectorAll('.slider-dot');

      function goTo(index) {
        if (index < 0) index = total - 1;
        if (index >= total) index = 0;
        current = index;
        track.style.transform = 'translateX(-' + (current * 100) + '%)';
        for (var j = 0; j < dots.length; j++) {
          dots[j].className = 'slider-dot' + (j === current ? ' active' : '');
        }
      }

      function next() { goTo(current + 1); }
      function prev() { goTo(current - 1); }

      nextBtn.addEventListener('click', function() { next(); resetInterval(); });
      prevBtn.addEventListener('click', function() { prev(); resetInterval(); });

      dotsContainer.addEventListener('click', function(e) {
        if (e.target.classList.contains('slider-dot')) {
          goTo(parseInt(e.target.getAttribute('data-index')));
          resetInterval();
        }
      });

      function startInterval() {
        interval = setInterval(next, 3000);
      }

      function resetInterval() {
        clearInterval(interval);
        startInterval();
      }

      startInterval();
    })();
  </script>
</Layout>


<style>
  /* NAVBAR */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    padding: 0.8rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo img {
    height: 50px;
    width: auto;
    border-radius: 8px;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-links a {
    font-weight: 500;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: var(--azul-claro);
  }

  .btn-nav {
    background: var(--gradiente);
    color: var(--blanco) !important;
    padding: 0.6rem 1.5rem;
    border-radius: 30px;
    font-weight: 600;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .btn-nav:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(26, 82, 118, 0.3);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
  }

  .menu-toggle span {
    width: 25px;
    height: 3px;
    background: var(--azul-primario);
    border-radius: 3px;
    transition: 0.3s;
  }

  /* HERO */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--gradiente);
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-content {
    position: relative;
    text-align: center;
    color: var(--blanco);
    padding-top: 80px;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .highlight {
    background: linear-gradient(120deg, #27ae60, #2ecc71);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 2.5rem;
    opacity: 0.9;
    font-weight: 300;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .hero-social-icon {
    color: var(--blanco);
    opacity: 0.85;
    transition: opacity 0.3s, transform 0.3s;
  }

  .hero-social-icon:hover {
    opacity: 1;
    transform: scale(1.15);
  }

  .btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    border-radius: 30px;
    font-weight: 600;
    font-size: 1rem;
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--verde-claro);
    color: var(--blanco);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(39, 174, 96, 0.4);
  }

  .btn-secondary {
    background: transparent;
    color: var(--blanco);
    border: 2px solid var(--blanco);
  }

  .btn-secondary:hover {
    background: var(--blanco);
    color: var(--azul-primario);
    transform: translateY(-3px);
  }

  .btn-full {
    width: 100%;
  }

  /* SECCIONES */
  .section-title {
    font-size: 2.2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--azul-primario);
  }

  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  /* SERVICIOS */
  .servicios {
    padding: 6rem 0;
    background: var(--gris-claro);
  }

  .slider-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .slider-container {
    overflow: hidden;
    flex: 1;
    border-radius: 16px;
  }

  .slider-track {
    display: flex;
    transition: transform 0.5s ease;
  }

  .servicio-card {
    min-width: 100%;
    background: var(--blanco);
    padding: 3rem 2rem;
    border-radius: 16px;
    text-align: center;
    border: 1px solid #e8f4f8;
    box-sizing: border-box;
  }

  .slider-btn {
    background: var(--azul-primario);
    color: var(--blanco);
    border: none;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s, transform 0.3s;
    flex-shrink: 0;
  }

  .slider-btn:hover {
    background: var(--verde-claro);
    transform: scale(1.1);
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .slider-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ccc;
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
  }

  .slider-dot.active {
    background: var(--azul-primario);
    transform: scale(1.2);
  }

  .servicio-icon {
    font-size: 3rem;
    margin-bottom: 1.2rem;
